# Cấu hình cho docker compose. Chép file này thành .env (cùng thư mục với docker-compose.yml) rồi điền giá trị.
# File .env chứa mật khẩu: KHÔNG commit (.gitignore đã chặn). Không đặt dấu ngoặc kép quanh giá trị.

# ---- MySQL chạy trong Docker (chỉ dùng khi tạo volume db-data lần đầu)
MYSQL_ROOT_PASSWORD=
DB_USERNAME=clothing_app
DB_PASSWORD=

# ---- Cổng mở ra máy thật: 127.0.0.1 = chỉ máy này truy cập; 0.0.0.0 = mọi máy (cần thì mới mở)
APP_BIND=127.0.0.1
APP_PORT=8080

# ---- Khóa bí mật ký link trong email: chuỗi ngẫu nhiên từ 32 ký tự
CLOTHINGSHOP_APP_SECRET=
# Địa chỉ gốc của trang (link trong email, Return URL của VNPAY); không có dấu / ở cuối
CLOTHINGSHOP_APP_BASEURL=http://localhost:8080

# ---- Tài khoản quản lý, tạo một lần khi ứng dụng khởi động mà chưa có tài khoản quản lý (mật khẩu từ 8 ký tự)
CLOTHINGSHOP_ADMIN_USERNAME=
CLOTHINGSHOP_ADMIN_EMAIL=
CLOTHINGSHOP_ADMIN_PASSWORD=
CLOTHINGSHOP_ADMIN_FULLNAME=
CLOTHINGSHOP_ADMIN_PHONE=

# ---- Gửi email qua SMTP (để trống host thì email chỉ ghi vào log: docker compose logs app)
CLOTHINGSHOP_MAIL_SMTP_HOST=
CLOTHINGSHOP_MAIL_SMTP_PORT=587
CLOTHINGSHOP_MAIL_SMTP_USERNAME=
CLOTHINGSHOP_MAIL_SMTP_PASSWORD=
CLOTHINGSHOP_MAIL_SMTP_STARTTLS=true
CLOTHINGSHOP_MAIL_FROM=

# ---- VNPAY (để trống thì chỉ có COD). Sandbox: lấy mã TMN và khóa bí mật ở trang merchant của VNPAY
CLOTHINGSHOP_VNPAY_TMNCODE=
CLOTHINGSHOP_VNPAY_HASHSECRET=
# Máy cá nhân VNPAY không gọi IPN tới được thì đặt true (xem README mục VNPAY)
CLOTHINGSHOP_VNPAY_PROCESSRETURNURL=false

CLOTHINGSHOP_SHOP_SHIPPINGFEE=20000
