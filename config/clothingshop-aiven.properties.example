# Cấu hình kết nối MySQL trên Aiven (https://aiven.io).
# Host, Port, User, Password và CA certificate (ca.pem) lấy ở trang Overview của MySQL service trên Aiven.
# Cách dùng giống config/clothingshop.properties.example: chép ra ngoài repo, điền giá trị, trỏ CLOTHINGSHOP_CONFIG tới file.
#
# Aiven bắt buộc kết nối SSL. Nên kiểm tra chứng chỉ của server (sslMode=VERIFY_CA) bằng truststore tạo từ ca.pem:
#   keytool -importcert -noprompt -alias aiven-ca -file ca.pem -keystore aiven-truststore.p12 -storetype PKCS12 -storepass <mật khẩu truststore>
# Nếu chỉ cần chạy thử, có thể dùng sslMode=REQUIRED (vẫn mã hóa nhưng không kiểm tra chứng chỉ).
#
# Trước khi chạy ứng dụng lần đầu, tạo bảng:
#   mysql --host=<host> --port=<port> --user=avnadmin --password --ssl-mode=REQUIRED < database/schema.sql

db.url=jdbc:mysql://<host>:<port>/clothing_shop?sslMode=VERIFY_CA&trustCertificateKeyStoreUrl=file:/duong/dan/aiven-truststore.p12&trustCertificateKeyStoreType=PKCS12&trustCertificateKeyStorePassword=<mật khẩu truststore>
db.username=avnadmin
db.password=
# Gói nhỏ của Aiven giới hạn số kết nối đồng thời; giữ pool nhỏ.
db.pool.maxSize=5

app.secret=
app.baseUrl=https://<tên miền khi triển khai>/clothing-shop

mail.smtp.host=
mail.smtp.port=587
mail.smtp.username=
mail.smtp.password=
mail.smtp.starttls=true
mail.from=

# ---- Tài khoản quản lý (BR-24): tạo một lần khi ứng dụng khởi động mà chưa có tài khoản quản lý.
# Sau lần khởi động đầu tiên nên xóa admin.password khỏi file.
admin.userName=
admin.email=
admin.password=
admin.fullName=
admin.phone=
#admin.gender=OTHER
#admin.dob=1990-01-01

# ---- VNPAY (để trống thì trang đặt hàng chỉ cho chọn COD). Lấy ở trang quản trị merchant của VNPAY.
vnpay.tmnCode=
vnpay.hashSecret=
#vnpay.payUrl=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
#vnpay.apiUrl=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
#vnpay.serverIp=127.0.0.1
#vnpay.paymentTimeoutMinutes=15
# Máy cá nhân mà VNPAY không gọi IPN tới được: đặt true để trang kết quả cũng áp dụng kết quả có chữ ký
#vnpay.processReturnUrl=false

# ---- Khác
#shop.shippingFee=20000
#scheduler.enabled=true
