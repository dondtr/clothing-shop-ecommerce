<%-- Phần đầu trang dùng chung (template Shoppers của Colorlib, CC BY 3.0).
     Trang gọi đặt trước: pageTitle, activeNav (home | shop). --%>
<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title><c:out value="${empty pageTitle ? 'Thời trang mỗi ngày' : pageTitle}"/> &mdash; Shoppers</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@300;400;500;600;700&amp;display=swap">
  <link rel="stylesheet" href="${ctx}/assets/fonts/icomoon/style.css">
  <link rel="stylesheet" href="${ctx}/assets/css/bootstrap.min.css">
  <link rel="stylesheet" href="${ctx}/assets/css/magnific-popup.css">
  <link rel="stylesheet" href="${ctx}/assets/css/jquery-ui.css">
  <link rel="stylesheet" href="${ctx}/assets/css/owl.carousel.min.css">
  <link rel="stylesheet" href="${ctx}/assets/css/owl.theme.default.min.css">
  <link rel="stylesheet" href="${ctx}/assets/css/aos.css">
  <link rel="stylesheet" href="${ctx}/assets/css/style.css">
  <link rel="stylesheet" href="${ctx}/assets/css/shop.css">
</head>
<body>
<div class="site-wrap">
  <header class="site-navbar" role="banner">
    <div class="site-navbar-top">
      <div class="container">
        <div class="row align-items-center">

          <div class="col-6 col-md-4 order-2 order-md-1 site-search-icon text-left">
            <form action="${ctx}/shop" method="get" class="site-block-top-search">
              <span class="icon icon-search2"></span>
              <input type="text" name="q" value="${fn:escapeXml(param.q)}" class="form-control border-0"
                     placeholder="Tìm áo, quần, giày...">
            </form>
          </div>

          <div class="col-12 mb-3 mb-md-0 col-md-4 order-1 order-md-2 text-center">
            <div class="site-logo">
              <a href="${ctx}/" class="js-logo-clone">Shoppers</a>
            </div>
          </div>

          <div class="col-6 col-md-4 order-3 order-md-3 text-right">
            <div class="site-top-icons">
              <ul>
                <li class="dropdown account-menu">
                  <a href="#" class="dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" title="Tài khoản">
                    <span class="icon icon-person"></span>
                    <c:if test="${not empty sessionScope.auth}">
                      <span class="d-none d-lg-inline small"><c:out value="${sessionScope.auth.fullName}"/></span>
                    </c:if>
                  </a>
                  <div class="dropdown-menu dropdown-menu-right">
                    <c:choose>
                      <c:when test="${empty sessionScope.auth}">
                        <a class="dropdown-item" href="${ctx}/login">Đăng nhập</a>
                        <a class="dropdown-item" href="${ctx}/register">Đăng ký</a>
                      </c:when>
                      <c:otherwise>
                        <h6 class="dropdown-header">
                          <c:out value="${sessionScope.auth.userName}"/>
                          <c:if test="${sessionScope.auth.employee}">(${sessionScope.auth.admin ? 'Quản lý' : 'Nhân viên'})</c:if>
                        </h6>
                        <c:if test="${sessionScope.auth.employee}">
                          <a class="dropdown-item" href="${ctx}/staff">Khu quản lý</a>
                        </c:if>
                        <a class="dropdown-item" href="${ctx}/account/profile">Thông tin cá nhân</a>
                        <a class="dropdown-item" href="${ctx}/account/password">Đổi mật khẩu</a>
                        <c:if test="${sessionScope.auth.customer}">
                          <a class="dropdown-item" href="${ctx}/orders">Đơn hàng của tôi</a>
                          <a class="dropdown-item" href="${ctx}/account/addresses">Sổ địa chỉ</a>
                          <a class="dropdown-item" href="${ctx}/vouchers">Voucher của tôi</a>
                        </c:if>
                        <div class="dropdown-divider"></div>
                        <form action="${ctx}/logout" method="post" class="m-0">
                          <input type="hidden" name="_csrf" value="${sessionScope.csrfToken}">
                          <button type="submit" class="dropdown-item">Đăng xuất</button>
                        </form>
                      </c:otherwise>
                    </c:choose>
                  </div>
                </li>
                <%-- Giỏ hàng và danh sách yêu thích chỉ hiện khi khách hàng đã đăng nhập (Q40, BR-25) --%>
                <c:if test="${sessionScope.auth.customer}">
                  <li><a href="${ctx}/wishlist" class="site-cart" title="Yêu thích"><span class="icon icon-heart-o"></span></a></li>
                  <li><a href="${ctx}/cart" class="site-cart" title="Giỏ hàng"><span class="icon icon-shopping_cart"></span></a></li>
                </c:if>
                <li class="d-inline-block d-md-none ml-md-0">
                  <a href="#" class="site-menu-toggle js-menu-toggle"><span class="icon-menu"></span></a>
                </li>
              </ul>
            </div>
          </div>

        </div>
      </div>
    </div>
    <nav class="site-navigation text-right text-md-center" role="navigation">
      <div class="container">
        <ul class="site-menu js-clone-nav d-none d-md-block">
          <li class="${activeNav == 'home' ? 'active' : ''}"><a href="${ctx}/">Trang chủ</a></li>
          <li class="has-children ${activeNav == 'shop' ? 'active' : ''}">
            <a href="${ctx}/shop">Cửa hàng</a>
            <%-- Danh mục cố định theo ENUM Product.category (Q08) --%>
            <ul class="dropdown">
              <li><a href="${ctx}/shop?category=SHIRT">Áo</a></li>
              <li><a href="${ctx}/shop?category=PANTS">Quần</a></li>
              <li><a href="${ctx}/shop?category=DRESS">Váy đầm</a></li>
              <li><a href="${ctx}/shop?category=SHOES">Giày dép</a></li>
              <li><a href="${ctx}/shop?category=HAT">Mũ nón</a></li>
              <li><a href="${ctx}/shop?category=ACCESSORY">Phụ kiện</a></li>
            </ul>
          </li>
        </ul>
      </div>
    </nav>
  </header>

  <c:if test="${not empty sessionScope.flash}">
    <div class="container mt-3">
      <div class="alert alert-${sessionScope.flash.type} alert-dismissible fade show mb-0" role="alert">
        <c:out value="${sessionScope.flash.message}"/>
        <button type="button" class="close" data-dismiss="alert" aria-label="Đóng"><span aria-hidden="true">&times;</span></button>
      </div>
    </div>
    <c:remove var="flash" scope="session"/>
  </c:if>
